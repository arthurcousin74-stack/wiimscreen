// wiimscreen.exe resources: the manifest (UTF-8 code page) and the version shown in the file's properties.
// Compiled by tools/windows_build.py (windres); wiimscreen_version.h is written there in the build folder.
#include <winver.h>

#include "wiimscreen_version.h"

1 24 "wiimscreen.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0, 0, 0, 0
PRODUCTVERSION 0, 0, 0, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "wiimscreen - WiiM remote"
            VALUE "ProductName", "wiimscreen"
            VALUE "ProductVersion", WIIMSCREEN_VERSION
            VALUE "FileVersion", WIIMSCREEN_VERSION
            VALUE "OriginalFilename", "wiimscreen.exe"
            VALUE "LegalCopyright", "MIT License"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
